#!/usr/bin/env zsh
# ~/.config/zsh/utils/zshenv_report
# ===========================================================================
# --- Zsh Environment Report ---
# Generates a report of key environment variables and paths
# Useful for debugging and ensuring correct setup
# ===========================================================================
local logfile="${ZLOGDIR:-$HOME/.config/zsh/logs}/zshenv_report.log"
mkdir -p "${logfile:h}"   # ensure log dir exists

{
    echo "=== Zsh Environment Report ==="
    echo "Generated: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "------------------------------"
    echo "LANG=             $LANG"
    echo "LC_ALL=           $LC_ALL"
    echo "HOME (~)=         $HOME"
    echo "---"
    echo "GIT_PROVIDER=     $GIT_PROVIDER"
    echo "GITHUB_USER=      ${GITHUB_USER:-not_set}"
    echo "GITLAB_USER=      ${GITLAB_USER:-not_set}"
    echo "---"
    echo "XDG_CONFIG_HOME=  ${${XDG_CONFIG_HOME:-not_set}/$HOME/~}"
    echo "XDG_DATA_HOME=    ${${XDG_DATA_HOME:-not_set}/$HOME/~}"
    echo "XDG_STATE_HOME=   ${${XDG_STATE_HOME:-not_set}/$HOME/~}"
    echo "XDG_CACHE_HOME=   ${${XDG_CACHE_HOME:-not_set}/$HOME/~}"
    echo "XDG_RUNTIME_DIR=  ${${XDG_RUNTIME_DIR:-not_set}/$HOME/~}"
    echo "XDG_BIN_HOME=     ${${XDG_BIN_HOME:-not_set}/$HOME/~}"
    echo "---"
    echo "ZDOTDIR=          ${${ZDOTDIR:-not_set}/$HOME/~}"
    echo "ZLOGDIR=          ${${ZLOGDIR:-not_set}/$HOME/~}"
    echo "ZSHLIB=           ${${ZSHLIB:-not_set}/$HOME/~}"
    echo "BREWDOTS=         ${${BREWDOTS:-not_set}/$HOME/~}"
    echo "BREWLOGS=         ${${BREWLOGS:-not_set}/$HOME/~}"
    echo "BRUTILS=          ${${BRUTILS:-not_set}/$HOME/~}"
    echo "ZUTILS=           ${${ZUTILS:-not_set}/$HOME/~}"
    echo "BAT_CONFIG_DIR=   ${${BAT_CONFIG_DIR:-not_set}/$HOME/~}"
    echo "GUTILS=           ${${GUTILS:-not_set}/$HOME/~}"
    echo 
    echo "ZLOGFILE=         ${${ZLOGFILE:-not_set}/$HOME/~}"
    echo "---"
    echo "EDITOR=           $EDITOR"
    echo "VISUAL=           $VISUAL"
    echo
    echo "ZSHENV_DEBUG=     $ZSHENV_DEBUG"
    echo "ZSHF_VERBOSE=     $ZSHF_VERBOSE"
    echo "ZSH_DEBUG_BOOT=   $ZSH_DEBUG_BOOT"
    echo "------------------------------"
    echo "PATH=$(echo -e "\t"--${PATH//:/\\n\\t--})"
    echo "==================================="
} >| "$logfile"
/bin/cat "$logfile"
